{
  "id":"./?app=despesas",
  "name":"FAST - Despesas",
  "version": "2.3.51",
  "short_name":"Despesas",
  "description":"Acesso direto às Despesas da FAST Serviços",
  "start_url":"./?exclusive=despesas&atalho=despesas",
  "scope":"./",
  "display":"standalone",
  "background_color":"#dc2626",
  "theme_color":"#dc2626",
  "file_handlers":[
    {
      "action":"app-despesas/",
      "accept":{
        "application/pdf":[".pdf"],
        "image/png":[".png"],
        "image/jpeg":[".jpg",".jpeg"],
        "image/webp":[".webp"]
      },
      "launch_type":"single-client"
    }
  ],
  "share_target":{
    "action":"app-despesas/",
    "method":"POST",
    "enctype":"multipart/form-data",
    "params":{
      "title":"title",
      "text":"text",
      "url":"url",
      "files":[
        {"name":"comprovante","accept":["application/pdf",".pdf","image/*",".jpg",".jpeg",".png",".webp"]}
      ]
    }
  },
  "icons":[
    {
      "src":"assets/atalho-despesas-192.png?v=r145",
      "sizes":"192x192",
      "type":"image/png",
      "purpose":"any maskable"
    },
    {
      "src":"assets/atalho-despesas-512.png?v=r145",
      "sizes":"512x512",
      "type":"image/png",
      "purpose":"any maskable"
    }
  ]
}
