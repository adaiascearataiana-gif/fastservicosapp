    {"src":"../assets/atalho-despesas-512.png?v=r145","sizes":"512x512","type":"image/png","purpose":"any"},
    {"src":"../assets/atalho-despesas-512.png?v=r145","sizes":"512x512","type":"image/png","purpose":"maskable"}
