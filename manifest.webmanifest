{
  "name": "FAST Serviços - Gestão de Rotas",
  "short_name": "FAST Serviços",
  "version": "4.0.3",
  "description": "FAST Serviços 4.0.3 — Operações, rotas, clientes, equipe e finanças",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#07111f",
  "theme_color": "#07111f",
  "lang": "pt-BR",
  "categories": ["business", "productivity", "finance"],
  "file_handlers": [
    {
      "action": "app-despesas/",
      "accept": {
        "application/pdf": [".pdf"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"]
      },
      "launch_type": "single-client"
    }
  ],
  "icons": [
    {"src":"assets/fast-servicos-icon-192.png?v=2.1.0","sizes":"192x192","type":"image/png","purpose":"any"},
    {"src":"assets/fast-servicos-icon-512.png?v=2.1.0","sizes":"512x512","type":"image/png","purpose":"any maskable"}
  ],
  "shortcuts": [
    {
      "name":"Rotas do Dia",
      "short_name":"Rotas do Dia",
      "description":"Abrir diretamente as rotas programadas para hoje",
      "url":"rotas-do-dia/",
      "icons":[{"src":"assets/app-rotas-dia-192.png?v=r403","sizes":"192x192","type":"image/png"}]
    },
    {
      "name":"Despesas",
      "short_name":"Despesas",
      "description":"Abrir diretamente o controle de despesas",
      "url":"despesas/",
      "icons":[{"src":"assets/app-despesas-192.png?v=r403","sizes":"192x192","type":"image/png"}]
    },
    {
      "name":"FAST Motorista",
      "short_name":"FAST Motorista",
      "description":"Rotas do dia, botão CHEGUEI, fotos e conclusão — direto do celular do motorista",
      "url":"app-motorista/",
      "icons":[{"src":"assets/app-motorista-192.png?v=r403","sizes":"192x192","type":"image/png"}]
    },
    {
      "name":"Cliente FAST",
      "short_name":"Cliente FAST",
      "description":"Cadastro, solicitação de destinos e acompanhamento de entregas",
      "url":"app-cliente/",
      "icons":[{"src":"assets/app-cliente-192.png?v=r403","sizes":"192x192","type":"image/png"}]
    }
  ]
}
